[Unit]
Description=WirePlumber Session Manager (System-Wide Root Mode)
After=pipewire-root.service
Requires=pipewire-root.service

[Service]
Type=simple
User=root
Group=root
Environment=XDG_RUNTIME_DIR=/run/pipewire
ExecStart=/usr/bin/wireplumber
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
