[Unit]
Description=Initialize ALSA Softvol Controls
After=sound.target local-fs.target usb-gadgets.service
Wants=usb-gadgets.service
Before=pipewire-root.service

[Service]
Type=oneshot
ExecStart=/usr/bin/aplay -D dac8x -f S32_LE -r 48000 -c 8 /dev/zero -d 1
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
