[Unit]
Description=PipeWire PulseAudio Emulation (System-Wide Root Mode)
After=pipewire-root.service wireplumber-root.service
Requires=pipewire-root.service

[Service]
Type=simple
User=root
Group=root
Environment=XDG_RUNTIME_DIR=/run/pipewire
ExecStart=/usr/bin/pipewire-pulse
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
