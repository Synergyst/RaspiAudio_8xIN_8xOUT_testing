[Unit]
Description=Lock AT2020USB+ Capture Volume to 69% (80% wpctl)
After=wireplumber-root.service pipewire-root.service wireplumber.service pipewire.service
Wants=wireplumber-root.service pipewire-root.service wireplumber.service pipewire.service

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=/run/user/0
ExecStart=/root/Sources/cm5audio/scripts/at2020-vol-fix.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
